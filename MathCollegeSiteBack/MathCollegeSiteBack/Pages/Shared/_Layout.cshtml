<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090918" />
    <title>@ViewData["Title"] — VARIQ</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="site-header">
        <div class="header-inner">
            <a class="brand" href="/" aria-label="VARIQ — главная">
                <span class="brand-mark" aria-hidden="true">∑</span>
                <span>VARIQ</span>
            </a>
            <button class="menu-toggle" id="menuToggle" type="button" aria-expanded="false" aria-controls="mainNav" aria-label="Открыть меню">
                <span></span><span></span><span></span>
            </button>
            <nav class="main-nav" id="mainNav" aria-label="Главная навигация">
                <a href="/Themes">Темы</a>
                <a href="/Practice">Задания</a>
                <a href="/Lab">Игры</a>
                <a href="/Journal">Факты</a>
            </nav>
            <div class="header-actions">
                <a class="streak-pill" id="streak-container" href="/Themes" title="Дней с завершёнными занятиями" hidden>
                    <svg class="fire-icon" viewBox="0 0 24 24" aria-hidden="true"><path class="fire-outer" d="M13.1 1.5c.8 4.8-2.1 5.4-.8 8.4.8 1.8 2.4 1.7 2.7-.3.2-1.2-.1-2.1.5-3.2 3.1 2.1 5 5.5 4.4 9.2-.6 4.1-3.8 7-8.1 7s-7.8-3.1-7.8-7.5c0-3.3 1.8-5.8 4.2-8.1-.1 3.3.9 4.2 1.8 3.8 1.5-.7 1.2-2.9 1.1-4.3-.1-1.8.4-3.5 2-5Z"/><path class="fire-inner" d="M12.6 12.2c.1 1.8-1.3 2.5-1.2 4.1.1 1.1.8 1.7 1.7 1.5.8-.2 1.1-1.1 1.2-1.8 1.1 1 1.7 2.1 1.6 3.3-.1 1.7-1.5 2.9-3.4 2.9s-3.5-1.4-3.5-3.3c0-1.6 1.1-3.1 3.6-6.7Z"/></svg><span id="streak-count">0</span><span class="streak-label">дней</span>
                </a>
                <a class="header-start" href="/Practice">К заданиям <span aria-hidden="true">↗</span></a>
            </div>
        </div>
    </header>

    <main class="page-main">
        @RenderBody()
    </main>

    <partial name="_Quant" />

    <footer class="site-footer">
        <a class="brand brand-small" href="/"><span class="brand-mark" aria-hidden="true">∑</span><span>VARIQ</span></a>
        <span>Вероятность — это способ увидеть закономерность в случайности.</span>
        <a href="/Themes">К учебной дорожке ↑</a>
    </footer>

    <script>
        (() => {
            const menuButton = document.getElementById('menuToggle');
            const nav = document.getElementById('mainNav');
            menuButton?.addEventListener('click', () => {
                const expanded = menuButton.getAttribute('aria-expanded') === 'true';
                menuButton.setAttribute('aria-expanded', String(!expanded));
                nav.classList.toggle('is-open', !expanded);
            });
            nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
                nav.classList.remove('is-open');
                menuButton?.setAttribute('aria-expanded', 'false');
            }));
            fetch('/api/streak/status').then(response => response.ok ? response.json() : null)
                .then(data => {
                    if (!data || !data.streak) return;
                    document.getElementById('streak-count').textContent = data.streak;
                    document.getElementById('streak-container').hidden = false;
                }).catch(() => {});

            const widget = document.getElementById('quantWidget');
            const toggle = document.getElementById('quantToggle');
            const bubble = document.getElementById('quantBubble');
            const speech = document.getElementById('quantSpeech');
            const actions = document.getElementById('quantActions');
            const pixelCanvas = document.getElementById('quantPixelCat');
            const pixelContext = pixelCanvas?.getContext('2d');
            const colors = { ink: '#211638', ink2: '#32204f', shadow: '#49316f', hoodie: '#211b3b', hoodLight: '#49366f', furDark: '#6845ae', fur: '#9770df', furLight: '#b99af0', cream: '#e0d2ff', gleam: '#fff2ff', ear: '#db8fdb', earLight: '#f5b9e9', eye: '#fff7ff', pupil: '#25183e', blush: '#e995c9', sigma: '#d3b4ff' };
            const pixel = (x, y, color, w = 1, h = 1) => { pixelContext.fillStyle = colors[color] || color; pixelContext.fillRect(x, y, w, h); };
            const rows = (list, color) => list.forEach(([y, left, right]) => pixel(left, y, color, right - left + 1));
            let catFrame = 0;
            const drawQuantCat = () => {
                if (!pixelContext) return;
                const mood = widget.dataset.mood || 'idle';
                const blink = mood !== 'happy' && catFrame % 36 < 2;
                const bounce = mood === 'happy' && catFrame % 2 ? -1 : (catFrame % 8 === 0 ? -1 : 0);
                const tail = [0, 0, 1, 2, 1, 0, -1, -1][catFrame % 8];
                const step = mood === 'walking' ? (catFrame % 2 ? 1 : -1) : 0;
                pixelContext.clearRect(0, 0, 56, 56);
                pixelContext.save(); pixelContext.translate(0, bounce);
                // Fluffy tail behind the body, with a lavender tip.
                rows([[34,41,47],[33,43,48],[32,45,49],[31,47,50],[30,49,51],[29,50,52],[28,50,53],[27,49,53],[26,48,52],[25,47,51],[24,46,50],[23,45,49],[22,44,48]].map(([y,l,r])=>[y,l+tail,r+tail]), 'ink');
                rows([[34,42,46],[33,44,47],[32,46,48],[31,48,49],[30,50,50],[29,51,51],[28,51,52],[27,50,52],[26,49,51],[25,48,50],[24,47,49],[23,46,48]].map(([y,l,r])=>[y,l+tail,r+tail]), 'fur');
                rows([[31,47,47],[30,49,49],[29,50,50],[28,51,51],[27,50,51],[26,49,50],[25,48,49]].map(([y,l,r])=>[y,l+tail,r+tail]), 'furLight');
                // Pointed ears with dark pixel outlines and pink inner fur.
                rows([[3,13,16],[4,12,17],[5,11,18],[6,10,19],[7,9,20],[8,8,21],[9,8,22],[10,8,23],[11,9,24],[12,10,25],[13,11,26],[14,12,27],[15,13,28],[16,14,29],[17,15,30]], 'ink');
                rows([[4,13,15],[5,12,16],[6,11,17],[7,10,18],[8,9,19],[9,9,20],[10,9,21],[11,10,22],[12,11,23],[13,12,24],[14,13,25],[15,14,26],[16,15,27]], 'fur');
                rows([[6,13,15],[7,12,16],[8,11,17],[9,11,18],[10,12,18],[11,13,19],[12,14,20],[13,15,21]], 'ear');
                rows([[3,39,42],[4,38,43],[5,37,44],[6,36,45],[7,35,46],[8,34,47],[9,33,48],[10,32,48],[11,31,47],[12,30,46],[13,29,45],[14,28,44],[15,27,43],[16,26,42],[17,25,41]], 'ink');
                rows([[4,40,42],[5,39,43],[6,38,44],[7,37,45],[8,36,46],[9,35,47],[10,34,47],[11,33,46],[12,32,45],[13,31,44],[14,30,43],[15,29,42],[16,28,41]], 'fur');
                rows([[6,40,42],[7,39,43],[8,38,44],[9,37,44],[10,36,43],[11,35,42],[12,34,41],[13,33,40]], 'ear');
                rows([[8,24,26],[9,23,27],[10,22,28]], 'furLight');
                // Big soft head silhouette, with little cheek tufts.
                rows([[10,20,35],[11,16,39],[12,14,41],[13,12,43],[14,10,45],[15,9,46],[16,8,47],[17,7,48],[18,7,48],[19,6,49],[20,6,49],[21,6,49],[22,6,49],[23,7,48],[24,6,49],[25,7,48],[26,8,47],[27,9,46],[28,11,44],[29,13,42],[30,16,39],[31,19,36],[32,22,33]], 'ink');
                rows([[11,20,35],[12,17,39],[13,15,41],[14,13,43],[15,11,44],[16,10,45],[17,9,46],[18,8,47],[19,8,47],[20,7,48],[21,7,48],[22,7,48],[23,8,47],[24,7,48],[25,8,47],[26,9,46],[27,10,45],[28,12,43],[29,14,41],[30,17,38],[31,21,34]], 'fur');
                rows([[12,20,30],[13,17,31],[14,15,31],[15,13,29],[16,12,27],[17,11,25],[18,10,23]], 'furLight');
                rows([[12,21,26],[13,19,26],[14,17,24]], 'cream');
                rows([[17,15,20],[18,13,18],[19,12,16]], 'gleam');
                // Side tufts make the face feel soft instead of a round blob.
                rows([[19,5,8],[20,4,8],[21,5,9],[22,4,9],[23,5,10],[24,5,10],[25,7,11],[26,9,13]], 'furDark');
                rows([[19,47,50],[20,47,51],[21,46,50],[22,47,51],[23,46,50],[24,45,50],[25,44,48],[26,42,46]], 'furDark');
                // Hoodie, oversized sleeves, feet and front panel.
                rows([[31,20,35],[32,16,39],[33,13,42],[34,11,44],[35,10,45],[36,9,46],[37,9,46],[38,10,45],[39,11,44],[40,12,43],[41,13,42],[42,14,41],[43,15,40],[44,16,39],[45,17,38],[46,18,37]], 'ink');
                rows([[32,21,34],[33,17,38],[34,14,41],[35,12,43],[36,11,44],[37,11,44],[38,12,43],[39,13,42],[40,14,41],[41,15,40],[42,16,39],[43,17,38],[44,18,37]], 'hoodie');
                rows([[33,20,23],[34,17,20],[35,15,18],[36,14,17],[37,13,16],[38,13,16],[39,14,17]], 'hoodLight');
                rows([[35,38,41],[36,40,43],[37,41,44],[38,41,44],[39,40,43]], 'hoodLight');
                // Hoodie folds and cuffs.
                rows([[39,14,17],[40,15,18],[41,16,19],[42,17,20]], 'shadow');
                rows([[38,37,41],[39,36,40],[40,35,39],[41,34,38]], 'shadow');
                // Two little shoes/paws; tiny alternating step stays inside the canvas.
                rows([[44,17+step,25+step],[45,16+step,26+step],[46,16+step,27+step],[47,17+step,27+step],[44,30-step,38-step],[45,29-step,39-step],[46,28-step,39-step],[47,28-step,38-step]], 'ink');
                rows([[45,18+step,24+step],[46,17+step,26+step],[47,18+step,26+step],[45,31-step,37-step],[46,29-step,38-step],[47,29-step,37-step]], 'furLight');
                pixel(20+step, 45, 'cream', 3, 1); pixel(32-step, 45, 'cream', 3, 1);
                // Face: big shining eyes, expressive brows and tiny muzzle.
                if (mood === 'happy' || blink) {
                    rows([[20,15,17],[19,16,19],[20,20,21],[19,22,25],[20,26,28]], 'ink');
                    if (mood === 'happy') { pixel(16, 21, 'blush', 4, 2); pixel(37, 21, 'blush', 4, 2); }
                } else {
                    rows([[17,14,18],[18,13,18],[17,24,28],[18,24,29]], mood === 'worried' ? 'ink' : 'furDark');
                    rows([[19,13,19],[20,12,20],[21,12,20],[22,13,19],[23,14,18],[19,24,30],[20,23,31],[21,23,31],[22,24,30],[23,25,29]], 'ink');
                    rows([[20,14,18],[21,13,19],[22,14,18],[20,25,29],[21,24,30],[22,25,29]], 'eye');
                    const glance = mood === 'thinking' ? 2 : (mood === 'worried' ? -1 : 0);
                    rows([[20,16+glance,17+glance],[21,15+glance,18+glance],[22,16+glance,17+glance],[20,27+glance,28+glance],[21,26+glance,29+glance],[22,27+glance,28+glance]], 'pupil');
                    pixel(15+glance, 20, 'gleam', 2, 2); pixel(26+glance, 20, 'gleam', 2, 2);
                    if (mood === 'worried') { rows([[24,10,14],[25,12,16],[24,31,35],[25,29,33]], 'blush'); }
                }
                // Small nose, smile and cheek pixels.
                pixel(26, 25, 'furDark', 3, 1); pixel(27, 26, 'ink', 1, 1);
                if (mood === 'talking' && catFrame % 2 === 0) { pixel(26, 27, 'ink', 4, 3); pixel(27, 27, 'ear', 2, 1); }
                else { pixel(26, 27, 'ink', 2, 1); pixel(27, 28, 'ink', 2, 1); }
                if (mood !== 'happy' && mood !== 'worried') { pixel(12, 24, 'blush', 3, 1); pixel(34, 24, 'blush', 3, 1); }
                // Hood strings and unmistakable Sigma mark.
                rows([[35,26,26],[36,25,25],[37,26,26],[38,25,25]], 'furLight');
                pixel(29, 36, 'sigma', 7, 1); pixel(33, 37, 'sigma', 2, 1); pixel(30, 38, 'sigma', 4, 1); pixel(33, 39, 'sigma', 2, 1); pixel(29, 40, 'sigma', 7, 1);
                // Thinking paw near the chin; the face remains visible.
                if (mood === 'thinking') { rows([[28,35,37],[29,34,38],[30,35,38]], 'furLight'); }
                // Tiny pixel spark on happy response.
                if (mood === 'happy') { pixel(3, 15 + (catFrame % 2), 'gleam', 2, 2); pixel(5, 13 + (catFrame % 2), 'sigma', 1, 2); }
                pixelContext.restore();
            };
            window.setInterval(() => { catFrame++; drawQuantCat(); }, 360);
            const defaults = {
                '/': 'Привет! Я Квант. Готов открыть первую тему? Жми «Темы» — и пойдём по дорожке вместе.',
                '/themes': 'На дорожке можно выбирать любой урок. Пройденные темы доступны для повтора, а следующий шаг подсвечен.',
                '/practice': 'Выбирай урок и тренируйся. Если ответ не получится, я помогу спокойно разобрать решение.',
                '/lab': 'Здесь можно бросать монету, менять форму кривой и играть в задачу с дверями. Попробуй сам(а)!',
                '/journal': 'У меня есть короткие заметки о странных и красивых закономерностях. Выбирай любую!',
                '/task': 'Давай разберём урок по маленьким шагам. Я рядом, если станет трудно.'
            };
            const route = location.pathname.toLowerCase();
            const defaultMessage = defaults[route] || defaults['/'];
            const setMood = mood => { widget.dataset.mood = mood || 'idle'; drawQuantCat(); };
            const say = (message, mood = 'talking', choices = []) => {
                speech.textContent = message || defaultMessage;
                setMood(mood);
                actions.replaceChildren();
                for (const choice of choices) {
                    const button = document.createElement('button');
                    button.type = 'button'; button.textContent = choice.label;
                    button.addEventListener('click', choice.onClick);
                    actions.appendChild(button);
                }
                actions.hidden = choices.length === 0;
                bubble.hidden = false;
                toggle.setAttribute('aria-expanded', 'true');
                window.clearTimeout(window.quantSpeechTimer);
                if (!choices.length) window.quantSpeechTimer = window.setTimeout(() => { bubble.hidden = true; toggle.setAttribute('aria-expanded', 'false'); setMood('idle'); }, 6500);
            };
            toggle?.addEventListener('click', () => {
                if (bubble.hidden) say(defaultMessage, 'happy');
                else { bubble.hidden = true; toggle.setAttribute('aria-expanded', 'false'); setMood('idle'); }
            });
            document.getElementById('quantClose')?.addEventListener('click', () => { bubble.hidden = true; toggle.setAttribute('aria-expanded', 'false'); setMood('idle'); });
            drawQuantCat();
            window.VariqCat = { say, setMood, close: () => { bubble.hidden = true; toggle.setAttribute('aria-expanded', 'false'); setMood('idle'); } };
            document.addEventListener('click', event => {
                const prompt = event.target.closest('[data-quant-say]');
                if (prompt) say(prompt.dataset.quantSay, 'happy');
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
