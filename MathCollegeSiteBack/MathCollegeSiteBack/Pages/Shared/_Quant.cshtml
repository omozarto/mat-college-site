<aside class="quant-widget" id="quantWidget" data-mood="idle">
    <div class="quant-bubble" id="quantBubble" hidden>
        <div class="quant-bubble-head"><strong>Квант</strong><button type="button" id="quantClose" aria-label="Свернуть Кванта">×</button></div>
        <p id="quantSpeech">Привет! Я Квант. Вместе разберёмся даже со сложной вероятностью.</p>
        <div id="quantActions" class="quant-actions" hidden></div>
        <form class="quant-chat-form" id="quantChatForm">
            <label class="quant-ask-label" for="quantQuestionInput">Задай вопрос Кванту</label>
            <div class="quant-chat-entry">
                <input id="quantQuestionInput" name="question" type="text" maxlength="300" placeholder="Например: как решить это задание?" autocomplete="off" />
                <button id="quantAskButton" type="submit" aria-label="Отправить вопрос">↗</button>
            </div>
        </form>
        <p class="quant-suggest-label">Или выбери подсказку</p>
        <div id="quantQuestions" class="quant-questions"></div>
    </div>
    <button class="quant-companion" id="quantToggle" type="button" aria-label="Поговорить с котиком Квантом" aria-expanded="false">
        <img class="quant-pixel-cat" id="quantPixelCat" src="~/images/quant-idle.png" asp-append-version="true" alt="Квант — пиксельный котик в фиолетовом худи" />
        <span class="quant-name">Квант <small>твой напарник</small></span>
    </button>
</aside>
