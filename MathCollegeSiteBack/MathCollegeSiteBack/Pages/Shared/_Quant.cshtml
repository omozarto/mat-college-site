<aside class="quant-widget" id="quantWidget" data-mood="idle">
    <div class="quant-bubble" id="quantBubble" hidden>
        <div class="quant-bubble-head"><strong>Квант</strong><button type="button" id="quantClose" aria-label="Свернуть Кванта">×</button></div>
        <p id="quantSpeech">Привет! Я Квант. Вместе разберёмся даже со сложной вероятностью.</p>
        <div id="quantActions" class="quant-actions" hidden></div>
    </div>
    <button class="quant-companion" id="quantToggle" type="button" aria-label="Поговорить с котиком Квантом" aria-expanded="false">
        <span class="quant-companion-spark" aria-hidden="true">✦</span>
        <canvas class="quant-pixel-cat" id="quantPixelCat" width="40" height="40" role="img" aria-label="Пиксельный котик Квант в фиолетовом худи"></canvas>
        <span class="quant-name">Квант <small>твой напарник</small></span>
    </button>
</aside>
