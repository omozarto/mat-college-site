@page
@model IndexModel
@{
    ViewData["Title"] = "Теория вероятностей без скуки";
}

<section class="hero-shell">
    <div class="hero-copy">
        <span class="eyebrow"><span class="eyebrow-spark">✦</span> МАТЕМАТИКА, КОТОРУЮ МОЖНО ПОЧУВСТВОВАТЬ</span>
        <h1>Мир вероятностей<br />начинается <span>здесь.</span></h1>
        <p>Исследуй случайные события, находи закономерности и учись на практике — в своём темпе и вместе с VARIQ.</p>
        <div class="hero-actions">
            <a class="button button-primary" href="/Themes">Начать обучение <span aria-hidden="true">→</span></a>
            <a class="button button-quiet" href="/#lab"><span class="play-symbol" aria-hidden="true">▶</span> Открыть лабораторию</a>
        </div>
        <div class="hero-metrics" aria-label="О курсе">
            <div><span class="metric-icon">✧</span><span><strong id="topicMetric">16</strong><small>тем курса</small></span></div>
            <div><span class="metric-icon">▥</span><span><strong id="taskMetric">640</strong><small>заданий для практики</small></span></div>
            <div><span class="metric-icon">◷</span><span><strong>∞</strong><small>новых вариантов</small></span></div>
        </div>
    </div>

    <div class="hero-art" aria-label="Кривая нормального распределения">
        <div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div>
        <div class="formula-chip formula-left">P(A) = <span>|A|</span>/<span>|Ω|</span></div>
        <div class="formula-chip formula-right">μ = 0&nbsp;&nbsp; σ = 1</div>
        <svg class="bell-graph" viewBox="0 0 640 380" role="img" aria-label="График колоколообразного распределения">
            <defs>
                <linearGradient id="curveFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#9c78ff" stop-opacity=".52"/><stop offset="1" stop-color="#7151e8" stop-opacity="0"/></linearGradient>
                <linearGradient id="curveStroke"><stop stop-color="#9474ff"/><stop offset=".52" stop-color="#e5d8ff"/><stop offset="1" stop-color="#8462ff"/></linearGradient>
                <filter id="curveGlow"><feGaussianBlur stdDeviation="7" result="blur"/><feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
            </defs>
            <g class="graph-grid"><path d="M50 50H600M50 110H600M50 170H600M50 230H600M50 290H600M50 350H600"/><path d="M80 35V350M160 35V350M240 35V350M320 35V350M400 35V350M480 35V350M560 35V350"/></g>
            <path class="graph-area" d="M50 335 C125 333 150 322 200 284 C248 246 264 124 320 62 C376 124 392 246 440 284 C490 322 515 333 590 335 L590 350 L50 350Z"/>
            <path class="graph-curve" d="M50 335 C125 333 150 322 200 284 C248 246 264 124 320 62 C376 124 392 246 440 284 C490 322 515 333 590 335"/>
            <path class="graph-axis" d="M50 350H600M320 40V350"/><path class="graph-dash" d="M320 63V350"/>
            <circle class="graph-dot" cx="320" cy="62" r="6"/><circle class="graph-dot dot-small" cx="200" cy="284" r="4"/><circle class="graph-dot dot-small" cx="440" cy="284" r="4"/>
        </svg>
        <span class="float-star star-a">✦</span><span class="float-star star-b">✧</span><span class="float-star star-c">·</span>
        <div class="dice-cube" aria-hidden="true"><span>⚄</span></div>
        <div class="graph-caption"><span class="caption-dot"></span> Нормальное распределение <span class="caption-mu">μ = 0</span></div>
    </div>
</section>

<section class="section-block explore-section" aria-labelledby="exploreTitle">
    <div class="section-heading">
        <div><span class="section-kicker">КАРТА КУРСА</span><h2 id="exploreTitle">Выбери, что исследовать</h2></div>
        <a class="text-link" href="/Themes">Вся дорожка <span aria-hidden="true">→</span></a>
    </div>
    <div class="explore-grid">
        <a class="explore-card" href="/Themes"><span class="explore-icon icon-dice">⚄</span><span><strong>Теория вероятностей</strong><small>События, исходы и комбинаторика</small></span><span class="card-arrow">↗</span></a>
        <a class="explore-card" href="/Themes"><span class="explore-icon icon-bell">∿</span><span><strong>Случайные величины</strong><small>Распределения, ожидание и разброс</small></span><span class="card-arrow">↗</span></a>
        <a class="explore-card" href="/Themes"><span class="explore-icon icon-bars">▥</span><span><strong>Математическая статистика</strong><small>Выборки, оценки и гипотезы</small></span><span class="card-arrow">↗</span></a>
        <a class="explore-card" href="/Themes"><span class="explore-icon icon-book">▤</span><span><strong>Понятные объяснения</strong><small>Идеи, формулы и разборы по шагам</small></span><span class="card-arrow">↗</span></a>
        <a class="explore-card" href="/Themes"><span class="explore-icon icon-check">✓</span><span><strong>Практика с подсказками</strong><small>Новые примеры в каждом прохождении</small></span><span class="card-arrow">↗</span></a>
        <a class="explore-card" href="/#lab"><span class="explore-icon icon-orbit">✧</span><span><strong>Интерактивная лаборатория</strong><small>Эксперименты, которые можно повторить</small></span><span class="card-arrow">↗</span></a>
    </div>
</section>

<section class="lab-section" id="lab" aria-labelledby="labTitle">
    <div class="lab-heading"><div><span class="section-kicker">ПРОВЕРЬ САМ(А)</span><h2 id="labTitle">Маленькая лаборатория</h2><p>Поиграй со случайностью — и посмотри, как теория проявляется в результатах.</p></div><span class="lab-orbit-mark" aria-hidden="true">✳</span></div>
    <div class="lab-grid">
        <article class="lab-card coin-card">
            <div class="lab-card-title"><span class="lab-icon coin-icon">◉</span><div><h3>Монета</h3><p>Станет ли частота ближе к ½?</p></div></div>
            <div class="coin-stage"><div class="coin-visual" id="coinVisual" aria-hidden="true">V</div><div class="coin-result"><span>Орёл</span><strong id="coinFrequency">—</strong><div class="frequency-track"><span id="coinBar"></span></div><small>Теория: 0,50</small></div></div>
            <div class="lab-controls"><label for="coinTrials">Бросков</label><select id="coinTrials"><option value="10">10</option><option value="100" selected>100</option><option value="1000">1 000</option></select><button class="button button-small" id="flipCoinButton" type="button">Бросить монету <span>↗</span></button></div>
            <p class="lab-feedback" id="coinFeedback" aria-live="polite">Нажми на кнопку, чтобы начать эксперимент.</p>
        </article>
        <article class="lab-card normal-card">
            <div class="lab-card-title"><span class="lab-icon bell-icon">∿</span><div><h3>Форма распределения</h3><p>Поменяй параметры кривой</p></div></div>
            <div class="normal-demo">
                <svg id="normalDemo" viewBox="0 0 520 210" role="img" aria-label="Интерактивная кривая нормального распределения">
                    <defs><linearGradient id="miniFill" x1="0" x2="0" y1="0" y2="1"><stop stop-color="#9a7aff" stop-opacity=".55"/><stop offset="1" stop-color="#7151e8" stop-opacity="0"/></linearGradient></defs>
                    <path class="mini-grid" d="M30 35H500M30 80H500M30 125H500M30 170H500M80 20V180M160 20V180M240 20V180M320 20V180M400 20V180M480 20V180"/>
                    <path id="normalArea" class="mini-area" d=""/><path id="normalCurve" class="mini-curve" d=""/>
                    <path id="normalMeanLine" class="mini-mean" d=""/>
                </svg>
            </div>
            <div class="slider-row"><label for="meanSlider">Среднее <span id="meanLabel">0</span></label><input id="meanSlider" type="range" min="-3" max="3" step="0.1" value="0" /></div>
            <div class="slider-row"><label for="sigmaSlider">Разброс <span id="sigmaLabel">1,0</span></label><input id="sigmaSlider" type="range" min="0.5" max="2.5" step="0.1" value="1" /></div>
            <p class="lab-feedback">Среднее сдвигает центр. Разброс делает кривую шире или уже.</p>
        </article>
    </div>
    <article class="lab-card monty-card">
        <div class="lab-card-title"><span class="lab-icon">🚪</span><div><h3>Три двери</h3><p>Сможешь ли ты обыграть интуицию?</p></div><span class="monty-rounds" id="montyScore">0 побед / 0 раундов</span></div>
        <p class="monty-instructions" id="montyStatus" aria-live="polite">За одной дверью спрятан приз. Выбери дверь — ведущий откроет одну пустую, а ты решишь, менять ли выбор.</p>
        <div class="monty-doors" id="montyDoors" aria-label="Выбери одну из трёх дверей">
            <button type="button" data-door="0" aria-label="Выбрать дверь 1"><span class="door-number">01</span><span class="door-face">🚪</span><small>Дверь 1</small></button>
            <button type="button" data-door="1" aria-label="Выбрать дверь 2"><span class="door-number">02</span><span class="door-face">🚪</span><small>Дверь 2</small></button>
            <button type="button" data-door="2" aria-label="Выбрать дверь 3"><span class="door-number">03</span><span class="door-face">🚪</span><small>Дверь 3</small></button>
        </div>
        <div class="monty-actions" id="montyActions" hidden>
            <span>Твой первый выбор отмечен ✦</span>
            <button class="button button-small" type="button" data-strategy="stay">Остаться</button>
            <button class="button button-small" type="button" data-strategy="switch">Сменить дверь</button>
        </div>
        <button class="button button-quiet monty-next" id="montyNext" type="button" hidden>Следующий раунд ↻</button>
        <p class="monty-explanation" id="montyExplanation"></p>
    </article>
</section>

<section class="journal-section section-block" id="journal" aria-labelledby="journalTitle">
    <div class="section-heading"><div><span class="section-kicker">ЗАМЕТКИ ИЗ МИРА СЛУЧАЙНОСТИ</span><h2 id="journalTitle">Факты, которые удивляют</h2></div><span class="journal-note">Короткое чтение между уроками ✦</span></div>
    <div class="journal-grid">
        <details class="journal-card"><summary><span class="journal-number">01 / ПАРАДОКС</span><span class="journal-symbol">🎂</span><h3>Почему в группе так часто совпадают дни рождения?</h3><span class="journal-read">Открыть заметку <b>＋</b></span></summary><div class="journal-body"><p>В группе из 23 человек шанс, что хотя бы у двоих совпадёт день рождения, уже больше 50%. Мы сравниваем не одного человека со всеми, а каждую пару между собой.</p><span class="journal-tag">Комбинаторика · 2 минуты</span></div></details>
        <details class="journal-card"><summary><span class="journal-number">02 / ЭКСПЕРИМЕНТ</span><span class="journal-symbol">🪙</span><h3>Закон больших чисел не обещает идеальную половину</h3><span class="journal-read">Открыть заметку <b>＋</b></span></summary><div class="journal-body"><p>Длинная серия бросков обычно делает долю орлов ближе к ½, но не заставляет её стать ровно 0,5. Случайность колеблется — просто её относительное влияние уменьшается.</p><span class="journal-tag">Вероятность · 2 минуты</span></div></details>
        <details class="journal-card"><summary><span class="journal-number">03 / ЛОГИКА</span><span class="journal-symbol">🚪</span><h3>Задача Монти Холла: менять выбор выгоднее</h3><span class="journal-read">Открыть заметку <b>＋</b></span></summary><div class="journal-body"><p>Если ведущий знает, где приз, и всегда открывает пустую дверь, смена выбора повышает шанс выигрыша с ⅓ до ⅔. Новая информация меняет то, как распределяется вероятность.</p><span class="journal-tag">Условная вероятность · 3 минуты</span></div></details>
    </div>
</section>

<section class="pet-banner" aria-label="Твой помощник в обучении">
    <div class="pet-glow"></div>
    <div class="pet-copy"><span class="section-kicker">ТВОЙ СПУТНИК ПО КУРСУ</span><h2>Знакомься, <span>Квант.</span></h2><p>Он обожает закономерности, кубики и маленькие победы. Решай задания — Квант будет радоваться вместе с тобой.</p><a class="text-link" href="/Themes">Пройти первый урок <span>→</span></a></div>
    <div class="cat-stage" aria-label="Фиолетовый котик Квант">
        <span class="cat-spark cat-spark-one">✦</span><span class="cat-spark cat-spark-two">✧</span>
        <svg class="quant-cat" viewBox="0 0 260 250" role="img" aria-label="Милый фиолетовый кот в худи">
            <defs><linearGradient id="fur" x1="0" x2="1" y1="0" y2="1"><stop stop-color="#d9c4ff"/><stop offset=".52" stop-color="#9b79f4"/><stop offset="1" stop-color="#6847c5"/></linearGradient><linearGradient id="hoodie" x1="0" x2="1" y1="0" y2="1"><stop stop-color="#373064"/><stop offset="1" stop-color="#17172f"/></linearGradient></defs>
            <ellipse cx="132" cy="226" rx="76" ry="12" fill="#100e24" opacity=".8"/>
            <path class="cat-tail" d="M181 194c49 13 45 49 16 44-17-3-18-20-5-24" fill="none" stroke="url(#fur)" stroke-width="22" stroke-linecap="round"/>
            <path d="M72 104 57 28q-2-10 8-4l56 41M175 72l42-47q8-8 7 5l-4 76" fill="url(#fur)" stroke="#6c4ac5" stroke-width="4" stroke-linejoin="round"/>
            <path d="m76 83-7-42 32 35m59 8 32-37-4 48" fill="#e99bdc" opacity=".9"/>
            <path d="M60 112c0-42 31-73 73-73s72 31 72 73v38c0 43-32 65-73 65s-72-22-72-65z" fill="url(#fur)" stroke="#6c4ac5" stroke-width="4"/>
            <path d="M80 108c-4-17 8-27 20-17 9 8 7 26-1 31-8 5-16-2-19-14m78 0c4-17-8-27-20-17-9 8-7 26 1 31 8 5 16-2 19-14" fill="#17152d"/>
            <ellipse cx="93" cy="111" rx="3" ry="6" fill="#fff"/><ellipse cx="159" cy="111" rx="3" ry="6" fill="#fff"/>
            <path d="M121 131q8-7 16 0l-8 7z" fill="#492d83"/><path d="M129 138q-8 10-14 1m14-1q8 10 14 1" fill="none" stroke="#492d83" stroke-width="3" stroke-linecap="round"/>
            <path d="M71 173q-34 8-43-2m45 11q-33 18-45 12m165-21q34 8 43-2m-45 11q33 18 45 12" fill="none" stroke="#dbcaff" stroke-width="2" stroke-linecap="round"/>
            <path d="M70 171q-8 30 0 58h122q9-28-1-58-29 22-61 21-33 0-60-21" fill="url(#hoodie)" stroke="#6d56aa" stroke-width="3"/>
            <path d="M117 192v25m24-25v25" stroke="#b49af2" stroke-width="3" stroke-linecap="round"/><path d="m130 188 8 8-8 8-8-8z" fill="#9d7bfb"/><text x="130" y="200" fill="#201840" font-size="9" font-weight="bold" text-anchor="middle">Σ</text>
            <path d="M93 225q-18 8-24 0m97 0q18 8 24 0" fill="none" stroke="#cebaff" stroke-width="6" stroke-linecap="round"/>
        </svg>
        <div class="cat-nameplate"><span class="cat-heart">♥</span> Квант <span class="cat-level">ур. 1</span></div>
    </div>
</section>

@section Scripts {
<script>
(() => {
    const $ = id => document.getElementById(id);
    const format = value => Number(value).toLocaleString('ru-RU', { maximumFractionDigits: 2 });
    fetch('/api/topics').then(r => r.ok ? r.json() : []).then(topics => { if (topics.length) $('topicMetric').textContent = topics.length; }).catch(() => {});
    fetch('/api/lessons').then(r => r.ok ? r.json() : []).then(lessons => { const tasks = lessons.reduce((sum, lesson) => sum + lesson.taskCount, 0); if (tasks) $('taskMetric').textContent = format(tasks); }).catch(() => {});

    $('flipCoinButton').addEventListener('click', async () => {
        const button = $('flipCoinButton'); button.disabled = true; button.classList.add('is-busy');
        $('coinVisual').classList.remove('is-flipping'); void $('coinVisual').offsetWidth; $('coinVisual').classList.add('is-flipping');
        $('coinFeedback').textContent = 'Подбрасываем монету…';
        try {
            const response = await fetch('/api/experiments/coin', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ trials: Number($('coinTrials').value) }) });
            const data = await response.json(); if (!response.ok) throw new Error(data.message || 'Не удалось провести эксперимент.');
            $('coinFrequency').textContent = format(data.headsFrequency); $('coinBar').style.width = `${Math.min(100, data.headsFrequency * 100)}%`;
            $('coinFeedback').textContent = `Орёл выпал ${format(data.heads)} из ${format(data.trials)} раз. В этой серии частота равна ${format(data.headsFrequency)}.`;
        } catch (error) { $('coinFeedback').textContent = error.message; }
        finally { window.setTimeout(() => { button.disabled = false; button.classList.remove('is-busy'); }, 500); }
    });

    const drawNormal = () => {
        const mean = Number($('meanSlider').value), sigma = Number($('sigmaSlider').value);
        $('meanLabel').textContent = format(mean); $('sigmaLabel').textContent = format(sigma);
        const x0 = 30, width = 470, baseline = 180, amp = 142;
        const points = [];
        for (let i = 0; i <= 100; i++) {
            const x = i / 100 * 6 - 3;
            const density = Math.exp(-0.5 * Math.pow((x - mean) / sigma, 2));
            points.push(`${i === 0 ? 'M' : 'L'} ${(x0 + i / 100 * width).toFixed(1)} ${(baseline - density * amp).toFixed(1)}`);
        }
        const line = points.join(' ');
        $('normalCurve').setAttribute('d', line);
        $('normalArea').setAttribute('d', `${line} L ${x0 + width} ${baseline} L ${x0} ${baseline} Z`);
        const meanPosition = x0 + ((mean + 3) / 6) * width;
        $('normalMeanLine').setAttribute('d', `M ${meanPosition} 20 V ${baseline}`);
    };
    $('meanSlider').addEventListener('input', drawNormal); $('sigmaSlider').addEventListener('input', drawNormal); drawNormal();

    let prizeDoor = -1, firstDoor = -1, wins = 0, rounds = 0;
    const doorButtons = [...document.querySelectorAll('#montyDoors [data-door]')];
    const montyActions = $('montyActions');
    const montyNext = $('montyNext');
    const montyStatus = $('montyStatus');
    const montyExplanation = $('montyExplanation');
    const montyScore = $('montyScore');
    const startMontyRound = () => {
        prizeDoor = Math.floor(Math.random() * 3); firstDoor = -1;
        montyActions.hidden = true; montyNext.hidden = true; montyExplanation.textContent = '';
        montyStatus.textContent = 'За одной дверью спрятан приз. Выбери дверь — ведущий откроет одну пустую.';
        doorButtons.forEach(button => { button.disabled = false; button.classList.remove('is-picked', 'is-open', 'is-prize', 'is-goat'); button.querySelector('.door-face').textContent = '🚪'; });
    };
    doorButtons.forEach(button => button.addEventListener('click', () => {
        if (firstDoor >= 0) return;
        firstDoor = Number(button.dataset.door);
        button.classList.add('is-picked'); doorButtons.forEach(item => item.disabled = true);
        const hostDoor = [0, 1, 2].filter(door => door !== firstDoor && door !== prizeDoor)[Math.floor(Math.random() * [0, 1, 2].filter(door => door !== firstDoor && door !== prizeDoor).length)];
        const opened = doorButtons[hostDoor]; opened.classList.add('is-open', 'is-goat'); opened.querySelector('.door-face').textContent = '🐐';
        montyStatus.textContent = `Ведущий открыл дверь ${hostDoor + 1}. За ней коза. Оставишь свой выбор или сменишь?`;
        montyActions.hidden = false;
    }));
    montyActions.querySelectorAll('[data-strategy]').forEach(button => button.addEventListener('click', () => {
        const switchDoor = button.dataset.strategy === 'switch';
        const finalDoor = switchDoor ? doorButtons.find(item => Number(item.dataset.door) !== firstDoor && !item.classList.contains('is-open')) : doorButtons[firstDoor];
        const won = Number(finalDoor.dataset.door) === prizeDoor;
        rounds++; if (won) wins++;
        montyActions.hidden = true; montyNext.hidden = false;
        doorButtons.forEach(item => { item.disabled = true; if (Number(item.dataset.door) === prizeDoor) { item.classList.add('is-prize'); item.querySelector('.door-face').textContent = '🎁'; } });
        finalDoor.classList.add('is-picked');
        montyStatus.textContent = won ? 'Ура, приз за твоей дверью! ✨' : 'На этот раз приз был за другой дверью. Попробуем ещё?';
        montyExplanation.textContent = switchDoor
            ? 'Когда ты меняешь выбор, ты выигрываешь, если изначально выбрал(а) козу. Таких дверей две из трёх — поэтому стратегия смены даёт шанс ⅔.'
            : 'Если остаться, нужно было угадать приз с первой попытки. Шанс такого выбора — ⅓. При повторении серии преимущество смены становится заметнее.';
        montyScore.textContent = `${wins} ${wins === 1 ? 'победа' : 'побед'} / ${rounds} ${rounds === 1 ? 'раунд' : 'раундов'}`;
    }));
    montyNext.addEventListener('click', startMontyRound);
    startMontyRound();
})();
</script>
}
