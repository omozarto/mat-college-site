@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="welcome-page">
    <section class="welcome-hero">
        <div class="welcome-copy">
            <span class="eyebrow"><span class="eyebrow-spark">✦</span> VARIQ · ТЕОРИЯ ВЕРОЯТНОСТЕЙ</span>
            <h1>Случайность<br />можно <span>понять.</span></h1>
            <p>Учись видеть закономерности через понятные уроки, задачи и эксперименты. А Квант — твой котик‑напарник — будет рядом на каждом шаге.</p>
            <div class="hero-actions">
                <a class="button button-primary" href="/Themes">Открыть темы <span aria-hidden="true">→</span></a>
                <a class="button button-quiet" href="/Practice">Перейти к заданиям <span aria-hidden="true">↗</span></a>
            </div>
            <div class="welcome-note"><span class="welcome-note-mark">∑</span><span><strong>Твой темп. Твоя дорожка.</strong><small>Уроки можно повторять, а примеры при новом прохождении меняются.</small></span></div>
        </div>
        <div class="welcome-visual" aria-hidden="true">
            <div class="welcome-halo"></div><div class="welcome-ring ring-a"></div><div class="welcome-ring ring-b"></div>
            <svg class="welcome-curve" viewBox="0 0 600 360">
                <defs><linearGradient id="welcomeFill" x1="0" x2="0" y1="0" y2="1"><stop stop-color="#aa8cff" stop-opacity=".55"/><stop offset="1" stop-color="#7c5ce4" stop-opacity="0"/></linearGradient></defs>
                <g class="graph-grid"><path d="M40 60H560M40 120H560M40 180H560M40 240H560M40 300H560"/><path d="M100 40V310M190 40V310M280 40V310M370 40V310M460 40V310M550 40V310"/></g>
                <path class="welcome-area" d="M40 295 C130 294 170 272 215 221 C250 181 258 91 300 55 C342 91 350 181 385 221 C430 272 470 294 560 295 L560 310 L40 310Z"/>
                <path class="welcome-line" d="M40 295 C130 294 170 272 215 221 C250 181 258 91 300 55 C342 91 350 181 385 221 C430 272 470 294 560 295"/>
                <path class="graph-axis" d="M40 310H560M300 45V310"/><path class="graph-dash" d="M300 55V310"/><circle class="graph-dot" cx="300" cy="55" r="6"/>
            </svg>
            <span class="welcome-formula formula-one">P(A) = m / n</span><span class="welcome-formula formula-two">μ&nbsp; &nbsp;σ</span>
            <span class="welcome-star welcome-star-one">✦</span><span class="welcome-star welcome-star-two">✧</span><span class="welcome-star welcome-star-three">·</span>
            <div class="welcome-caption"><span></span> Каждая задача — новый шаг</div>
        </div>
    </section>
</div>
