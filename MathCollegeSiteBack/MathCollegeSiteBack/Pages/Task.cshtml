@page
@model MathCollegeSiteBack.Pages.TaskModel

@{
    ViewData["Title"] = "Урок";
}

<div class="lesson-page" id="lessonApp" data-lesson-id="@(Model.LessonId ?? 0)">
    <p id="statusMessage" class="status-message" role="status" aria-live="polite">
        Загружаем урок…
    </p>

    <section id="lessonIntro" class="lesson-card hidden">
        <div class="lesson-topline"><span class="lesson-kicker">ЗАНЯТИЕ VARIQ</span><a href="/Themes" class="lesson-back">← К темам</a></div>
        <h1 id="lessonTitle"></h1>
        <p id="lessonSummary"></p>

        <div class="lesson-theory-box">
            <h2>Объяснение темы</h2>
            <div class="lesson-learning-path" aria-hidden="true"><span>Идея</span><i></i><span>Формула</span><i></i><span>Пример</span><i></i><span>Практика</span></div>
            <div id="lessonContent" class="lesson-content"></div>
        </div>

        <section id="teacherWheel" class="teacher-wheel-panel" aria-labelledby="teacherWheelTitle">
            <div class="teacher-wheel-copy">
                <span class="teacher-wheel-kicker">ПО ЖЕЛАНИЮ ПРЕПОДАВАТЕЛЯ</span>
                <h2 id="teacherWheelTitle">Кто сегодня выходит к доске?</h2>
                <p>Колесо выберет номер ученика от 1 до 25. Можно пропустить и сразу начать урок.</p>
            </div>
            <div class="teacher-wheel-stage">
                <span class="wheel-pointer" aria-hidden="true"></span>
                <canvas id="studentWheelCanvas" width="440" height="440" role="img" aria-label="Колесо жеребьёвки с номерами учеников от 1 до 25"></canvas>
                <span class="wheel-center" aria-hidden="true">VARIQ</span>
            </div>
            <p id="teacherWheelResult" class="teacher-wheel-result" aria-live="polite"></p>
            <div class="teacher-wheel-actions">
                <button id="spinStudentWheel" class="wheel-spin-button" type="button">Крутить колесо</button>
                <button id="skipStudentWheel" class="wheel-skip-button" type="button">Пропустить</button>
            </div>
        </section>

        <section class="lesson-arcade" id="lessonArcade" aria-labelledby="lessonArcadeTitle">
            <div class="arcade-heading"><span class="arcade-icon" aria-hidden="true">✦</span><div><p>МИНИ-ИГРА УРОКА</p><h2 id="lessonArcadeTitle">Проверим догадку</h2></div><span class="arcade-stars">✦ <b id="arcadeScore">0</b></span></div>
            <p class="arcade-prompt" id="arcadePrompt"></p>
            <div id="arcadeOptions" class="arcade-options"></div>
            <p id="arcadeFeedback" class="arcade-feedback" aria-live="polite">Выбери ответ — Квант проверит твою догадку.</p>
            <button id="arcadeNext" class="arcade-next" type="button" hidden>Другая задача <span aria-hidden="true">↗</span></button>
        </section>

        <button id="startButton" class="lesson-button" type="button">
            Начать занятие
        </button>
    </section>

    <section id="taskSection" class="lesson-card hidden">
        <div class="task-topline"><p id="taskProgress"></p><span class="task-score-chip">✦ <span id="liveScore">0</span> баллов</span></div>
        <div class="task-progress-track" aria-label="Прогресс заданий"><i id="taskProgressFill"></i></div>
        <h2 id="taskPrompt"></h2>
        <div id="taskVisual" class="task-visual learning-visual"></div>

        <div id="answerOptions"></div>

        <input id="numberAnswer"
               class="number-answer hidden"
               type="number"
               step="any"
               placeholder="Введите число"
               aria-label="Числовой ответ" />

        <div>
            <button id="submitAnswerButton" class="lesson-button" type="button">
                Ответить
            </button>
        </div>
    </section>

    <section id="explanationPanel" class="explanation-box hidden">
        <h2 id="explanationTitle"></h2>
        <div id="explanationText" class="lesson-content"></div>
        <div id="solutionVisual" class="learning-visual"></div>
        <button id="explanationContinueButton" class="lesson-button" type="button">
            Продолжить
        </button>
    </section>

    <button id="finishButton" class="lesson-button secondary hidden" type="button">
        Завершить занятие
    </button>

    <section id="completionPanel" class="lesson-card hidden">
        <span class="completion-spark" aria-hidden="true">✦</span>
        <h2>Занятие завершено!</h2>
        <p id="completionMessage"></p>
        <p id="completionScore"></p>
        <p id="completionRating"></p>
        <a class="lesson-button" href="/Themes">Вернуться к темам</a>
    </section>
</div>

<script>
    const app = document.getElementById("lessonApp");
    const lessonId = Number(app.dataset.lessonId);

    const statusMessage = document.getElementById("statusMessage");
    const lessonIntro = document.getElementById("lessonIntro");
    const lessonTitle = document.getElementById("lessonTitle");
    const lessonSummary = document.getElementById("lessonSummary");
    const lessonContent = document.getElementById("lessonContent");
    const startButton = document.getElementById("startButton");
    const arcadePrompt = document.getElementById("arcadePrompt");
    const arcadeOptions = document.getElementById("arcadeOptions");
    const arcadeFeedback = document.getElementById("arcadeFeedback");
    const arcadeNext = document.getElementById("arcadeNext");
    const arcadeScore = document.getElementById("arcadeScore");
    const studentWheelCanvas = document.getElementById("studentWheelCanvas");
    const spinStudentWheel = document.getElementById("spinStudentWheel");
    const skipStudentWheel = document.getElementById("skipStudentWheel");
    const teacherWheelResult = document.getElementById("teacherWheelResult");
    let wheelRotation = 0;
    let wheelIsSpinning = false;

    const taskSection = document.getElementById("taskSection");
    const taskProgress = document.getElementById("taskProgress");
    const taskProgressFill = document.getElementById("taskProgressFill");
    const liveScore = document.getElementById("liveScore");
    const taskPrompt = document.getElementById("taskPrompt");
    const taskVisual = document.getElementById("taskVisual");
    const answerOptions = document.getElementById("answerOptions");
    const numberAnswer = document.getElementById("numberAnswer");
    const submitAnswerButton = document.getElementById("submitAnswerButton");

    const explanationPanel = document.getElementById("explanationPanel");
    const explanationTitle = document.getElementById("explanationTitle");
    const explanationText = document.getElementById("explanationText");
    const solutionVisual = document.getElementById("solutionVisual");
    const explanationContinueButton =
        document.getElementById("explanationContinueButton");

    const finishButton = document.getElementById("finishButton");

    const completionPanel = document.getElementById("completionPanel");
    const completionMessage = document.getElementById("completionMessage");
    const completionScore = document.getElementById("completionScore");
    const completionRating = document.getElementById("completionRating");

    let runId = null;
    let currentTask = null;
    let lessonTutorContext = {};
    let restartPending = false;
    let explanationAction = null;

    function drawStudentWheel() {
        const context = studentWheelCanvas?.getContext("2d");
        if (!context) return;
        const size = studentWheelCanvas.width, center = size / 2, radius = center - 15;
        const segment = Math.PI * 2 / 25, startAt = -Math.PI / 2;
        const colors = ["#684cae", "#865fc5", "#4a3b82", "#a178d7", "#57458f"];
        context.clearRect(0, 0, size, size);
        for (let index = 0; index < 25; index++) {
            const start = startAt + index * segment, end = start + segment;
            context.beginPath(); context.moveTo(center, center); context.arc(center, center, radius, start, end); context.closePath();
            context.fillStyle = colors[index % colors.length]; context.fill();
            context.strokeStyle = "rgba(234, 220, 255, .82)"; context.lineWidth = 2; context.stroke();
            const middle = start + segment / 2, labelRadius = radius * .76;
            const x = center + Math.cos(middle) * labelRadius, y = center + Math.sin(middle) * labelRadius;
            context.save(); context.translate(x, y); context.fillStyle = "#fff"; context.font = "700 15px Segoe UI, sans-serif";
            context.textAlign = "center"; context.textBaseline = "middle"; context.fillText(String(index + 1), 0, 0); context.restore();
        }
        context.beginPath(); context.arc(center, center, radius, 0, Math.PI * 2); context.strokeStyle = "#d0b7ff"; context.lineWidth = 5; context.stroke();
    }

    function initTeacherWheel() {
        if (!studentWheelCanvas || !spinStudentWheel || !skipStudentWheel) return;
        drawStudentWheel();
        spinStudentWheel.addEventListener("click", () => {
            if (wheelIsSpinning) return;
            wheelIsSpinning = true; spinStudentWheel.disabled = true; skipStudentWheel.disabled = true;
            const studentNumber = Math.floor(Math.random() * 25) + 1;
            const targetOffset = (360 - (studentNumber - .5) * (360 / 25)) % 360;
            const nextRotation = Math.ceil((wheelRotation + 5 * 360 - targetOffset) / 360) * 360 + targetOffset;
            wheelRotation = nextRotation;
            studentWheelCanvas.style.transform = `rotate(${nextRotation}deg)`;
            teacherWheelResult.classList.remove("is-ready");
            teacherWheelResult.textContent = "Колесо выбирает…";
            window.VariqCat?.say("Сейчас узнаем, кто сегодня поможет разобрать задачу у доски!", "surprised");
            let resultShown = false;
            const revealStudent = () => {
                if (resultShown) return;
                resultShown = true;
                wheelIsSpinning = false;
                teacherWheelResult.textContent = `Ученик ${studentNumber} выходит к доске!`;
                teacherWheelResult.classList.add("is-ready");
                spinStudentWheel.hidden = true; skipStudentWheel.hidden = true;
                startButton.textContent = `Начать урок · ученик ${studentNumber}`;
                window.VariqCat?.say(`Ученик ${studentNumber} выходит к доске! Я помогу с первым шагом задания.`, "happy");
            };
            studentWheelCanvas.addEventListener("transitionend", revealStudent, { once: true });
            window.setTimeout(revealStudent, 5600);
        });
        skipStudentWheel.addEventListener("click", () => {
            document.getElementById("teacherWheel").hidden = true;
            window.VariqCat?.say("Жеребьёвку пропускаем. Можно начинать урок!", "happy");
        });
    }

    function show(element) {
        element.classList.remove("hidden");
    }

    function hide(element) {
        element.classList.add("hidden");
    }

    function setStatus(message, isError = false) {
        statusMessage.textContent = message || "";
        statusMessage.style.color = isError ? "#ff8d9b" : "#72e8c7";
        if (message) window.VariqCat?.say(message, isError ? "worried" : "happy");
    }

    function renderLessonContent(content, contentBlocks = [], visualKind = "steps") {
        const paragraphs = String(content || "").split(/\r?\n\s*\r?\n|\r?\n/).map(item => item.trim()).filter(Boolean);
        const sections = [
            { title: "Главная идея", icon: "✦", kind: "idea", labels: ["Основная идея"] },
            { title: "Правило и формула", icon: "∑", kind: "formula", labels: ["Формула и алгоритм", "Формула"] },
            { title: "План решения", icon: "01", kind: "method", labels: ["План решения", "Шаги решения"] },
            { title: "Разбор на примере", icon: "↗", kind: "example", labels: ["Разобранный пример", "Пример"] },
            { title: "Смотри, как это устроено", icon: "◌", kind: "visual", labels: ["Наглядное объяснение", "Наглядно"] },
            { title: "Ловушка, которую обходим", icon: "!", kind: "caution", labels: ["Типичная ошибка", "Важно"] },
            { title: "Запомни главное", icon: "✓", kind: "summary", labels: ["Итог урока", "Итог"] }
        ];
        lessonContent.replaceChildren();
        const blocks = contentBlocks.length ? contentBlocks : paragraphs.map((paragraph, index) => {
            let descriptor = sections[index] || { title: "Ещё один важный шаг", icon: "✧", kind: "idea", labels: [] };
            for (const candidate of sections) {
                const label = candidate.labels.find(value => paragraph.toLocaleLowerCase('ru-RU').startsWith(value.toLocaleLowerCase('ru-RU') + '.'));
                if (label) { descriptor = candidate; paragraph = paragraph.slice(label.length + 1).trim(); break; }
            }
            return { kind: descriptor.kind, title: descriptor.title, text: paragraph };
        });
        blocks.forEach((block, index) => {
            const descriptor = sections.find(section => section.kind === block.kind) || sections[0];
            const chapter = document.createElement("section"); chapter.className = `lesson-beat is-${descriptor.kind}`;
            chapter.setAttribute("aria-label", block.title || descriptor.title);
            const number = document.createElement("span"); number.className = "beat-number"; number.textContent = String(index + 1).padStart(2, "0");
            const copy = document.createElement("div"); copy.className = "beat-copy";
            const heading = document.createElement("h3"); heading.textContent = block.title || descriptor.title;
            copy.appendChild(heading);

            if (block.kind === "formula") {
                const display = document.createElement("div"); display.className = "formula-display"; display.textContent = block.text || ""; copy.appendChild(display);
                const note = document.createElement("p"); note.className = "beat-note"; note.textContent = "Не заучивай символы отдельно: сначала свяжи каждый из них с тем, что происходит в задаче."; copy.appendChild(note);
            } else if (block.kind === "method") {
                const list = document.createElement("ol"); list.className = "method-steps";
                String(block.text || "").split(/(?=\d+\.\s)/).map(item => item.replace(/^\d+\.\s*/, "").trim()).filter(Boolean).forEach(item => { const li=document.createElement("li");li.textContent=item;list.appendChild(li); });
                copy.appendChild(list);
            } else if (block.kind === "example") {
                const board = document.createElement("div"); board.className = "example-board";
                const description = document.createElement("p"); description.className = "example-situation"; description.textContent = block.text || ""; board.appendChild(description);
                const calculation = (block.text || "").match(/(?:\d+\s*[\/×*]\s*\d+\s*=\s*[\d.,]+|[A-Za-zА-Яа-я]\([^)]*\)\s*=\s*[^.]+)/);
                if (calculation) { const result=document.createElement("div");result.className="example-calculation";const label=document.createElement("span");label.textContent="Считаем";const equation=document.createElement("strong");equation.textContent=calculation[0];result.append(label,equation);board.appendChild(result); }
                const insight = document.createElement("p"); insight.className = "example-insight"; insight.textContent = "Теперь объясни ответ обычными словами: что именно означает полученное число в условии?"; board.appendChild(insight);
                copy.appendChild(board);
            } else {
                const text = document.createElement("p"); text.className = "beat-text"; text.textContent = block.text || ""; copy.appendChild(text);
            }
            chapter.append(number, copy); lessonContent.appendChild(chapter);
        });
        renderLessonIllustration(visualKind);
        setupArcade(visualKind);
    }

    function renderLessonIllustration(kind) {
        const block = lessonContent.querySelector(".lesson-beat.is-visual .beat-copy");
        if (!block) return;
        const visual = document.createElement("div"); visual.className = "lesson-illustration";
        const svg = svgNode("svg", { viewBox: "0 0 560 220", role: "img", "aria-label": "Наглядная схема к уроку" });
        if (kind === "tree") {
            [[80,110,220,60],[80,110,220,160],[220,60,390,35],[220,60,390,85],[220,160,390,135],[220,160,390,185]].forEach(([x1,y1,x2,y2]) => svg.appendChild(svgNode("path", { d:`M${x1} ${y1}L${x2} ${y2}`, class:"illustration-line" })));
            [[80,110,"Старт"],[220,60,"выбор A"],[220,160,"выбор B"],[390,35,"1"],[390,85,"2"],[390,135,"3"],[390,185,"4"]].forEach(([x,y,t])=>{svg.appendChild(svgNode("circle",{cx:x,cy:y,r:25,class:"illustration-node"}));svg.appendChild(svgNode("text",{x,y:Number(y)+4,"text-anchor":"middle",class:"illustration-text"},t));});
        } else if (kind === "chart") {
            svg.appendChild(svgNode("path",{d:"M45 185H530M45 25V185",class:"illustration-axis"}));
            const values=[142,130,145,104,119,85,104,66,79,50,63,42,52,38];
            const points=values.map((v,i)=>`${i?"L":"M"} ${50+i*36} ${v}`).join(" ");
            svg.appendChild(svgNode("path",{d:points,class:"illustration-curve"}));svg.appendChild(svgNode("path",{d:"M45 105H530",class:"illustration-average"}));
            svg.appendChild(svgNode("text",{x:510,y:97,"text-anchor":"end",class:"illustration-text"},"ориентир модели"));
        } else if (kind === "table") {
            [[70,44,"Событие A"],[250,44,"Не A"],[70,112,"Условие B"],[250,112,"Не B"]].forEach(([x,y,label],i)=>{svg.appendChild(svgNode("rect",{x,y,width:160,height:52,rx:14,class:i===0?"illustration-cell is-highlight":"illustration-cell"}));svg.appendChild(svgNode("text",{x:Number(x)+80,y:Number(y)+31,"text-anchor":"middle",class:"illustration-text"},label));});
        } else {
            const labels=["все исходы","подходящие","вероятность"];
            labels.forEach((label,i)=>{const x=22+i*182;svg.appendChild(svgNode("rect",{x,y:77,width:150,height:68,rx:18,class:i===1?"illustration-node is-highlight":"illustration-node"}));svg.appendChild(svgNode("text",{x:x+75,y:118,"text-anchor":"middle",class:"illustration-text"},label));if(i<2)svg.appendChild(svgNode("path",{d:`M${x+153} 111h24m-8 -8 8 8 -8 8`,class:"illustration-line"}));});
        }
        visual.appendChild(svg); block.appendChild(visual);
    }

    const arcadeSets = {
        probability: [
            { q:"Справедливую монету подбросили один раз. Каков шанс орла?", options:["1/4","1/2","3/4"], answer:"1/2", why:"У монеты два равновозможных исхода, подходит один: 1/2." },
            { q:"На кубике сколько чётных граней из шести?", options:["2 из 6","3 из 6","5 из 6"], answer:"3 из 6", why:"Подходят числа 2, 4 и 6 — три грани из шести." }
        ],
        chart: [
            { q:"Зачем на графике частоты проводят линию P(A)=0,5?", options:["Это ориентир модели","Это гарантированный результат каждого броска","Это число всех опытов"], answer:"Это ориентир модели", why:"Отдельные серии колеблются, а линия показывает теоретическую вероятность." },
            { q:"Что обычно видно при увеличении числа опытов?", options:["Частота чаще держится ближе к модели","Частота всегда становится ровно 0,5","Исходы перестают быть случайными"], answer:"Частота чаще держится ближе к модели", why:"Колебания остаются, но их относительный масштаб обычно уменьшается." }
        ],
        tree: [
            { q:"Есть 3 футболки и 2 пары брюк. Сколько разных комплектов?", options:["5","6","9"], answer:"6", why:"Для каждой из трёх футболок подходят обе пары: 3 × 2 = 6." },
            { q:"Выбираем председателя и заместителя из 4 человек. Важен ли порядок?", options:["Да, роли разные","Нет, это одна команда","Только если людей больше пяти"], answer:"Да, роли разные", why:"Перестановка людей меняет назначение, потому что должности различаются." }
        ],
        table: [
            { q:"Из 20 студентов 5 изучают оба языка. Какую долю составляет эта группа?", options:["1/4","1/2","3/4"], answer:"1/4", why:"Нужную часть делим на всю группу: 5/20 = 1/4." },
            { q:"Если известно условие B, какую часть таблицы рассматриваем?", options:["Только группу B","Всю таблицу без изменений","Только строку итога"], answer:"Только группу B", why:"Условие ограничивает пространство до случаев, где B уже произошло." }
        ],
        steps: [
            { q:"На кубике выпало чётное число. Сколько исходов подходят?", options:["2","3","4"], answer:"3", why:"Чётные грани — 2, 4 и 6." },
            { q:"Как лучше округлять результат?", options:["После подстановки и вычислений","До выбора формулы","Всегда сразу до целого"], answer:"После подстановки и вычислений", why:"Раннее округление может накопить ошибку." }
        ]
    };
    let arcadeRound = 0, arcadePoints = 0, activeArcade = null;
    function setupArcade(kind) {
        const rounds = arcadeSets[kind] || arcadeSets.steps;
        arcadeRound = 0; arcadePoints = 0; arcadeScore.textContent = "0";
        const render = () => {
            activeArcade = rounds[arcadeRound % rounds.length]; arcadePrompt.textContent = activeArcade.q;
            arcadeFeedback.textContent = "Выбери ответ — Квант проверит твою догадку."; arcadeFeedback.className = "arcade-feedback";
            arcadeNext.hidden = true; arcadeOptions.replaceChildren();
            activeArcade.options.forEach(option => { const button=document.createElement("button");button.type="button";button.className="arcade-option";button.textContent=option;button.addEventListener("click",()=>{
                const correct=option===activeArcade.answer; if(correct){arcadePoints++;arcadeScore.textContent=String(arcadePoints);}
                arcadeOptions.querySelectorAll("button").forEach(item=>{item.disabled=true;if(item.textContent===activeArcade.answer)item.classList.add("is-correct");else if(item===button&&!correct)item.classList.add("is-wrong");});
                arcadeFeedback.textContent=`${correct?"Точно!":"Почти."} ${activeArcade.why}`;arcadeFeedback.classList.add(correct?"is-correct":"is-wrong");arcadeNext.hidden=false;
                window.VariqCat?.say(correct?"Есть! Ты поймал(а) закономерность.":"Ничего, разберём. " + activeArcade.why,correct?"happy":"thinking");
            });arcadeOptions.appendChild(button);});
        };
        arcadeNext.onclick=()=>{arcadeRound++;render();};render();
    }

    const svgNode = (name, attrs = {}, text = "") => {
        const node = document.createElementNS("http://www.w3.org/2000/svg", name);
        Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, value));
        if (text) node.textContent = text;
        return node;
    };

    function renderDiagram(container, kind, title, caption) {
        if (!container) return;
        container.replaceChildren();
        const figure = document.createElement("figure"); figure.className = `lesson-diagram diagram-${kind || "steps"}`;
        const heading = document.createElement("figcaption");
        const strong = document.createElement("strong"); strong.textContent = title;
        const note = document.createElement("span"); note.textContent = caption;
        heading.append(strong, note); figure.appendChild(heading);
        const svg = svgNode("svg", { viewBox: "0 0 480 170", role: "img", "aria-label": title });
        const defs = svgNode("defs");
        const gradient = svgNode("linearGradient", { id: `diagram-gradient-${container.id}`, x1: "0", x2: "0", y1: "0", y2: "1" });
        gradient.append(svgNode("stop", { offset: "0", "stop-color": "#ae91ff", "stop-opacity": ".72" }), svgNode("stop", { offset: "1", "stop-color": "#7352d4", "stop-opacity": ".12" }));
        defs.appendChild(gradient); svg.appendChild(defs);
        for (let y = 35; y <= 135; y += 50) svg.appendChild(svgNode("path", { d: `M36 ${y}H450`, class: "diagram-grid-line" }));
        if (kind === "tree") {
            [[95,85,210,50],[95,85,210,122],[210,50,340,32],[210,50,340,68],[210,122,340,104],[210,122,340,140]].forEach(([x1,y1,x2,y2]) => svg.appendChild(svgNode("path", { d: `M${x1} ${y1} L${x2} ${y2}`, class: "diagram-branch" })));
            [[95,85,"Старт"],[210,50,"A"],[210,122,"B"],[340,32,"1"],[340,68,"2"],[340,104,"3"],[340,140,"4"]].forEach(([x,y,label]) => { svg.appendChild(svgNode("circle", { cx:x, cy:y, r:17, class:"diagram-node" })); svg.appendChild(svgNode("text", { x, y:Number(y)+4, "text-anchor":"middle", class:"diagram-label" }, label)); });
        } else if (kind === "table") {
            [[130,48,"Группа B"],[250,48,"Не B"],[130,96,"Событие A"],[250,96,"Не A"]].forEach(([x,y,label],i) => {
                svg.appendChild(svgNode("rect", { x, y, width:112, height:39, rx:9, class:i===0?"diagram-cell is-active":"diagram-cell" }));
                svg.appendChild(svgNode("text", { x:Number(x)+56,y:Number(y)+24,"text-anchor":"middle",class:"diagram-label" }, label));
            });
        } else if (kind === "chart") {
            svg.appendChild(svgNode("path", { d:"M50 135H445M50 30V135", class:"diagram-axis" }));
            const barHeights=[40,64,52,91,76,112,94,124];
            barHeights.forEach((height,index)=>svg.appendChild(svgNode("rect",{x:75+index*44,y:135-height,width:25,height,rx:5,class:"diagram-bar"})));
            svg.appendChild(svgNode("path",{d:"M68 92H440",class:"diagram-average"}));
            svg.appendChild(svgNode("text",{x:440,y:85,"text-anchor":"end",class:"diagram-small-label"},"ориентир"));
        } else if (kind === "probability") {
            const cells = 10;
            for (let i=0;i<cells;i++) svg.appendChild(svgNode("rect",{x:45+i*39,y:54,width:31,height:43,rx:8,class:i<4?"diagram-cell is-active":"diagram-cell"}));
            svg.appendChild(svgNode("text",{x:45,y:125,class:"diagram-label"},"все возможные исходы"));
            svg.appendChild(svgNode("text",{x:435,y:125,"text-anchor":"end",class:"diagram-label"},"часть из них подходит событию"));
        } else {
            [["Условие",65],["Правило",210],["Проверка",355]].forEach(([label,x],index)=>{
                svg.appendChild(svgNode("rect",{x,y:57,width:105,height:54,rx:14,class:index===1?"diagram-node is-active":"diagram-node"}));
                svg.appendChild(svgNode("text",{x:Number(x)+52,y:89,"text-anchor":"middle",class:"diagram-label"},label));
                if(index<2) svg.appendChild(svgNode("path",{d:`M${Number(x)+108} 84h32m-8 -7 8 7 -8 7`,class:"diagram-branch"}));
            });
        }
        figure.appendChild(svg); container.appendChild(figure);
    }

    async function api(url, options = {}) {
        const response = await fetch(url, {
            ...options,
            headers: {
                "Content-Type": "application/json",
                ...(options.headers || {})
            }
        });

        let data = null;
        try {
            data = await response.json();
        } catch {
            data = null;
        }

        if (!response.ok) {
            const error = new Error(
                data?.message || `Ошибка сервера: ${response.status}`
            );
            error.status = response.status;
            throw error;
        }

        return data;
    }

    async function loadLesson() {
        if (!lessonId) {
            setStatus("Урок не выбран. Вернись на страницу тем и выбери урок.", true);
            return;
        }

        try {
            const lesson = await api(`/api/lessons/${lessonId}`);
            lessonTitle.textContent = lesson.title;
            lessonSummary.textContent = lesson.summary;
            renderLessonContent(lesson.content, lesson.contentBlocks || [], lesson.visualKind || "steps");
            const blocks = lesson.contentBlocks || [];
            lessonTutorContext = {
                pageTitle: lesson.title,
                pageText: lesson.content,
                lesson: {
                    title: lesson.title,
                    summary: lesson.summary,
                    coreIdea: blocks.find(block => block.kind === "idea")?.text,
                    formulaBlock: blocks.find(block => block.kind === "formula")?.text,
                    exampleBlock: blocks.find(block => block.kind === "example")?.text,
                    visualBlock: blocks.find(block => block.kind === "visual")?.text,
                    visualKind: lesson.visualKind
                },
                task: null,
                lastExplanation: null
            };
            window.VariqCat?.setContext(lessonTutorContext);
            hide(statusMessage);
            show(lessonIntro);
        } catch (error) {
            setStatus(error.message, true);
        }
    }

    async function startLesson() {
        try {
            if (restartPending) {
                restartPending = false;
                hide(lessonIntro);
                show(finishButton);
                setStatus("");
                await loadCurrentTask();
                return;
            }

            const result = await api(`/api/lessons/${lessonId}/start`, {
                method: "POST"
            });

            runId = result.runId;
            hide(lessonIntro);
            show(finishButton);
            setStatus("");
            await loadCurrentTask();
        } catch (error) {
            setStatus(error.message, true);
        }
    }

    async function loadCurrentTask(keepCatOpen = false) {
        if (!runId) {
            return;
        }

        hide(explanationPanel);
        if (!keepCatOpen) window.VariqCat?.close();
        answerOptions.replaceChildren();
        numberAnswer.value = "";
        currentTask = null;
        window.VariqCat?.setContext({ ...lessonTutorContext, task: null, lastExplanation: null });

        try {
            const task = await api(`/api/runs/${runId}/current`);
            currentTask = task;
            window.VariqCat?.setContext({
                ...lessonTutorContext,
                task: { prompt: task.prompt, taskOrder: task.taskOrder, taskCount: task.taskCount, attempts: task.attempts },
                lastExplanation: task.explanationRequired ? task.explanation : null
            });

            taskPrompt.textContent = task.prompt;
            renderDiagram(taskVisual, task.visualKind || "steps", "Схема перед решением", "Отметь известные данные, найди нужную связь и только потом считай.");
            taskProgress.textContent =
                `Задание ${task.taskOrder} из ${task.taskCount}. ` +
                `Попытка ${task.attempts + 1} из 3.`;
            taskProgressFill.style.width = `${Math.max(4, (task.taskOrder - 1) / task.taskCount * 100)}%`;

            if (task.explanationRequired) {
                hide(taskSection);
                displayExplanation(
                    task.explanationTitle || "Разбор задания",
                    task.explanation || "",
                    "Я прочитал(а), попробовать ещё раз",
                    () => markExplanationViewed(task.taskId), task.visualKind || "steps", task.solutionSteps || null
                );
                window.VariqCat?.ask("Объясни мою ошибку");
                return;
            }

            if (task.type === "choice") {
                hide(numberAnswer);

                task.options.forEach((option, index) => {
                    const label = document.createElement("label");
                    label.className = "answer-option";

                    const radio = document.createElement("input");
                    radio.type = "radio";
                    radio.name = "lessonAnswer";
                    radio.value = option.id;
                    radio.id = `answer-${index}`;

                    const text = document.createElement("span");
                    text.textContent = option.text;

                    label.append(radio, text);
                    answerOptions.appendChild(label);
                });
            } else if (task.type === "number") {
                show(numberAnswer);
            } else {
                setStatus("Этот тип задания пока не поддерживается.", true);
                hide(taskSection);
                return;
            }

            show(taskSection);
            setStatus("");
            if (task.taskOrder === 1 && task.attempts === 0) window.VariqCat?.ask("Подскажи первый шаг");
        } catch (error) {
            hide(taskSection);

            if (error.status === 409) {
                setStatus(error.message);
            } else {
                setStatus(error.message, true);
            }
        }
    }

    function displayExplanation(title, text, buttonText, action, visualKind = "steps", solutionSteps = null) {
        explanationTitle.textContent = title;
        explanationText.replaceChildren();
        const steps = solutionSteps?.length ? solutionSteps : String(text || "").split(/(?<=[.!?])\s+|\r?\n/).map(item => item.trim()).filter(Boolean);
        steps.forEach((paragraph, index) => {
            const step = document.createElement("article"); step.className = "solution-step";
            const number = document.createElement("span"); number.className = "solution-step-number"; number.textContent = String(index + 1).padStart(2, "0");
            const body = document.createElement("p"); body.textContent = paragraph; step.append(number, body); explanationText.appendChild(step);
        });
        renderDiagram(solutionVisual, visualKind, "Собираем решение по шагам", "Каждый шаг опирается на условие; итог проверяем по смыслу.");
        explanationContinueButton.textContent = buttonText;
        explanationAction = action;

        show(explanationPanel);
    }

    async function markExplanationViewed(taskId) {
        await api(`/api/runs/${runId}/tasks/${taskId}/explanation-viewed`, {
            method: "POST"
        });

        window.VariqCat?.close();
        await loadCurrentTask();
    }

    async function submitAnswer() {
        if (!runId || !currentTask) {
            return;
        }

        let answer;

        if (currentTask.type === "choice") {
            const selected = document.querySelector(
                'input[name="lessonAnswer"]:checked'
            );

            if (!selected) {
                setStatus("Сначала выбери вариант ответа.", true);
                return;
            }

            answer = { optionId: Number(selected.value) };
        } else {
            const value = numberAnswer.value.trim();

            if (!value) {
                setStatus("Введи числовой ответ.", true);
                return;
            }

            answer = { numericAnswer: Number(value) };
        }

        try {
            const result = await api(
                `/api/runs/${runId}/tasks/${currentTask.taskId}/answer`,
                {
                    method: "POST",
                    body: JSON.stringify(answer)
                }
            );
            if (result.score !== undefined) liveScore.textContent = result.score;

            hide(taskSection);

            if (result.lessonRestarted) {
                runId = result.newRunId;
                liveScore.textContent = "0";
                restartPending = true;
                renderLessonContent(result.lessonContent || "");
                startButton.textContent = "Начать урок заново";
                show(lessonIntro);
                setStatus(result.message);
                return;
            }

            if (!result.isCorrect) {
                setStatus(result.message, true);
                window.VariqCat?.setContext({
                    ...lessonTutorContext,
                    task: { prompt: currentTask.prompt, taskOrder: currentTask.taskOrder, taskCount: currentTask.taskCount, attempts: currentTask.attempts + 1 },
                    lastExplanation: result.explanation || null
                });
                displayExplanation(
                    result.explanationTitle || "Разбор задания",
                    result.explanation || "",
                    "Я прочитал(а), попробовать ещё раз",
                    () => markExplanationViewed(currentTask.taskId), currentTask.visualKind || "steps", currentTask.solutionSteps || null
                );
                window.VariqCat?.ask("Объясни мою ошибку");
                return;
            }

            setStatus("");
            window.VariqCat?.say(`Верно! В задании «${currentTask.prompt}» ты нашёл(ла) нужный ход. Сохраним этот способ и применим его дальше.`, "happy");
            await loadCurrentTask(true);
        } catch (error) {
            setStatus(error.message, true);
        }
    }

    async function finishLesson() {
        if (!runId) {
            return;
        }

        try {
            const result = await api(`/api/runs/${runId}/finish`, {
                method: "POST"
            });

            hide(taskSection);
            hide(explanationPanel);

            if (result.lessonCompleted) {
                hide(finishButton);
                completionMessage.textContent = result.message;
                completionScore.textContent =
                    `Баллы: ${result.score} из ${result.maximumScore}.`;
                completionRating.textContent =
                    `Рейтинг прохождения: ${result.ratingPercent}%. ` +
                    `Пересдач: ${result.retakesUsed}.`;

                if (result.currentStreak !== null) {
                    completionMessage.textContent +=
                        ` Серия огонька: ${result.currentStreak} дн.`;
                }

                show(completionPanel);
                setStatus("");
                return;
            }

            if (result.confirmationRequired) {
                setStatus("");
                window.VariqCat?.say("Остались нерешённые задания. Если выйти, прогресс этого урока будет потерян. Точно выйдем?", "worried", [
                    { label: "Да, выйти", onClick: confirmExit },
                    { label: "Нет, вернуться к уроку", onClick: async () => { window.VariqCat?.close(); await loadCurrentTask(); } }
                ]);
                return;
            }

            if (result.reviewRequired) {
                setStatus(result.message, true);

                displayExplanation(
                    result.explanationTitle || "Сначала разберём задание",
                    result.explanation || "",
                    "Перейти к заданию",
                    () => markExplanationViewed(result.taskId), "steps"
                );
                return;
            }

            setStatus(result.message || "Не удалось завершить занятие.", true);
        } catch (error) {
            setStatus(error.message, true);
        }
    }

    async function confirmExit() {
        try {
            await api(`/api/runs/${runId}/exit`, {
                method: "POST",
                body: JSON.stringify({ confirm: true })
            });

            window.location.href = "/Themes";
        } catch (error) {
            setStatus(error.message, true);
        }
    }

    startButton.addEventListener("click", startLesson);
    submitAnswerButton.addEventListener("click", submitAnswer);
    finishButton.addEventListener("click", finishLesson);
    explanationContinueButton.addEventListener("click", async () => {
        if (!explanationAction) {
            return;
        }

        try {
            await explanationAction();
            explanationAction = null;
            hide(explanationPanel);
        } catch (error) {
            setStatus(error.message, true);
        }
    });

    loadLesson();
    initTeacherWheel();
</script>
