@page
@model MathCollegeSiteBack.Pages.ThemesModel
@{
    ViewData["Title"] = "Дорожка обучения";
    var previousTopicCompleted = true;
    var completedLessons = Model.Topics.SelectMany(topic => topic.Lessons).Count(lesson => lesson.IsCompleted);
    var totalLessons = Model.Topics.Sum(topic => topic.Lessons.Count);
    var progressPercent = totalLessons == 0 ? 0 : (int)Math.Round(100d * completedLessons / totalLessons);
    var topicFacts = new[] {
        "В случайном опыте важны все возможные исходы, даже если некоторые из них кажутся неожиданными.",
        "Изменение порядка двух объектов удваивает число вариантов — если эти объекты различимы.",
        "Вероятность невозможного события равна нулю, а достоверного — единице.",
        "В длинной серии относительная частота обычно колеблется меньше, но точное совпадение не гарантировано.",
        "Порядок важен для пароля и распределения ролей, но обычно не важен для выбора команды.",
        "Если результат одного опыта не меняет шансы следующего, события независимы.",
        "Интуиция часто путает вероятность отдельного результата и вероятность целого набора результатов.",
        "Среднее может сильно сдвинуться из-за одного очень большого наблюдения.",
        "Два распределения могут иметь одинаковое среднее, но совсем разную форму и разброс.",
        "Колоколообразная кривая возникает во многих моделях, но реальные данные не обязаны быть нормальными.",
        "Среднее выборки становится надёжнее при росте объёма случайной выборки.",
        "Доверительный интервал — это метод, который при повторении строит интервалы с заданной долей попаданий.",
        "Статистическая значимость не говорит сама по себе, насколько эффект велик и важен на практике.",
        "Таблица сопряжённости помогает увидеть связь категорий, а не только сравнить отдельные числа.",
        "Сильная корреляция не доказывает, что изменение одной величины вызывает изменение другой.",
        "Симуляция помогает исследовать модель, но качество вывода зависит от того, насколько разумно заданы её правила."
    };
}

<main class="themes-page" id="roadmap">
    <div class="themes-topline">
        <div>
            <span class="section-kicker">ТВОЙ МАРШРУТ ПО КУРСУ</span>
            <h1>Дорожка открытий</h1>
            <p class="themes-intro">Иди шаг за шагом, возвращайся к пройденным урокам и открывай новые главы. Квант уже приготовил карту.</p>
        </div>
        <div class="roadmap-progress" aria-label="Общий прогресс курса">
            <span><span>Путь пройден</span><strong>@progressPercent%</strong></span>
            <div class="roadmap-track"><i style="width: @progressPercent%"></i></div>
            <span style="margin-top:6px"><span>@completedLessons из @totalLessons уроков</span><span>✦</span></span>
        </div>
    </div>

    @if (Model.Topics.Count == 0)
    {
        <div class="empty-message">Карта пока пуста. Скоро здесь появятся новые темы.</div>
    }
    else
    {
        <div class="roadmap">
            @for (var topicIndex = 0; topicIndex < Model.Topics.Count; topicIndex++)
            {
                var topic = Model.Topics[topicIndex];
                var topicCompleted = topic.Lessons.Count > 0 && topic.Lessons.All(lesson => lesson.IsCompleted);
                var isRecommended = !topicCompleted && previousTopicCompleted;
                var topicClass = topicCompleted ? "topic-stop is-complete" : isRecommended ? "topic-stop is-current" : "topic-stop";
                var firstIncompleteLesson = topic.Lessons.FirstOrDefault(lesson => !lesson.IsCompleted);
                var fact = topicFacts[topicIndex % topicFacts.Length];

                <section class="@topicClass">
                    <div class="topic-top">
                        <span class="topic-number">@(topicIndex + 1 < 10 ? $"0{topicIndex + 1}" : (topicIndex + 1).ToString())</span>
                        <div class="topic-heading">
                            <h2>@topic.Name</h2>
                            <p>@topic.Description</p>
                        </div>
                        @if (topicCompleted)
                        {
                            <span class="topic-status">✓ Глава пройдена</span>
                        }
                        else if (isRecommended)
                        {
                            <span class="topic-status">✦ Твой следующий шаг</span>
                        }
                    </div>

                    <details class="topic-fact">
                        <summary><span>✧</span> Факт на полях <b>＋</b></summary>
                        <p>@fact</p>
                    </details>

                    @if (topic.Lessons.Count == 0)
                    {
                        <p class="topic-empty">Уроки этой главы скоро появятся.</p>
                    }
                    else
                    {
                        <div class="topic-lessons">
                            @for (var lessonIndex = 0; lessonIndex < topic.Lessons.Count; lessonIndex++)
                            {
                                var lesson = topic.Lessons[lessonIndex];
                                var isNext = !lesson.IsCompleted && lesson.Id == firstIncompleteLesson?.Id;
                                var lessonClass = lesson.IsCompleted ? "path-lesson is-done" : isNext ? "path-lesson is-next" : "path-lesson";
                                <article class="@lessonClass">
                                    <span class="lesson-node">@(lesson.IsCompleted ? "✓" : (lessonIndex + 1).ToString())</span>
                                    <div>
                                        <strong>@lesson.Title</strong>
                                        <small>@lesson.TaskCount заданий <span aria-hidden="true">·</span> @(lesson.IsCompleted ? "Можно повторить" : "Объяснение и практика")</small>
                                    </div>
                                    <a href="/Task?lessonId=@lesson.Id">@(lesson.IsCompleted ? "Повторить ↻" : "Открыть →")</a>
                                </article>
                            }
                        </div>
                    }
                </section>
                previousTopicCompleted = topicCompleted;
            }
        </div>
        <div class="roadmap-legend" aria-label="Обозначения на дорожке">
            <span><i class="legend-dot"></i> пройдено — можно повторить</span>
            <span><i class="legend-dot next"></i> следующий шаг</span>
            <span><i class="legend-dot free"></i> открыть в любое время</span>
        </div>
    }
</main>
